<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_avs_aftersales_report_tree" model="ir.ui.view">
        <field name="name">avs.aftersales.report.tree</field>
        <field name="model">avs.aftersales.report</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="report_date"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="forwarded_to_id"/>
            </tree>
        </field>
    </record>

    <record id="view_avs_aftersales_report_form" model="ir.ui.view">
        <field name="name">avs.aftersales.report.form</field>
        <field name="model">avs.aftersales.report</field>
        <field name="arch" type="xml">
            <form string="Aftersales Report">
                <header>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                    <button name="action_record" type="object" string="Record" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_forward" type="object" string="Forward" class="btn-primary" invisible="state not in ('draft', 'recorded')"/>
                    <button name="action_mark_done" type="object" string="Mark Done" class="btn-success" invisible="state != 'forwarded'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,recorded,forwarded,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="report_date"/>
                            <field name="reporter_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="forwarded_to_id"/>
                            <field name="forwarded_by_id" readonly="1"/>
                            <field name="forwarded_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Tulis laporan aftersales di sini..."/>
                    </group>
                    <group>
                        <field name="forwarded_note" placeholder="Catatan penerusan laporan..."/>
                        <field name="resolution_note" placeholder="Catatan penyelesaian..."/>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avs_aftersales_report_search" model="ir.ui.view">
        <field name="name">avs.aftersales.report.search</field>
        <field name="model">avs.aftersales.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="forwarded_to_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Recorded" name="recorded" domain="[('state', '=', 'recorded')]"/>
                <filter string="Forwarded" name="forwarded" domain="[('state', '=', 'forwarded')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Assignee" name="group_forwarded_to" context="{'group_by': 'forwarded_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_avs_aftersales_report" model="ir.actions.act_window">
        <field name="name">Aftersales Reports</field>
        <field name="res_model">avs.aftersales.report</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_avs_aftersales_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first aftersales report.</p>
        </field>
    </record>

    <menuitem id="menu_avs_aftersales_report" name="Aftersales Reports" parent="project.menu_main_pm" action="action_avs_aftersales_report" sequence="40"/>
</odoo>
