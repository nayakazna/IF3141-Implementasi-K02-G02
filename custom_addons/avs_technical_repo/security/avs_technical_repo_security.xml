<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="avs_rule_technical_document_engineer_assigned_projects" model="ir.rule">
            <field name="name">Engineer: technical documents of assigned projects</field>
            <field name="model_id" ref="model_avs_technical_document"/>
            <field name="groups" eval="[(4, ref('avs_project.group_avs_engineer'))]"/>
            <field name="domain_force">['|', ('project_id.user_id', '=', user.id), ('project_id.task_ids.user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="avs_rule_technical_document_pmo_all" model="ir.rule">
            <field name="name">PMO: all technical documents</field>
            <field name="model_id" ref="model_avs_technical_document"/>
            <field name="groups" eval="[(4, ref('avs_project.group_avs_pmo'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="avs_rule_technical_document_sales_read_all" model="ir.rule">
            <field name="name">Sales: read all technical documents</field>
            <field name="model_id" ref="model_avs_technical_document"/>
            <field name="groups" eval="[(4, ref('avs_project.group_avs_sales'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
