<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_avs_technical_document_tree" model="ir.ui.view">
        <field name="name">avs.technical.document.tree</field>
        <field name="model">avs.technical.document</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="upload_date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="doc_type"/>
                <field name="version" widget="badge" decoration-info="1"/>
                <field name="uploaded_by"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_avs_technical_document_form" model="ir.ui.view">
        <field name="name">avs.technical.document.form</field>
        <field name="model">avs.technical.document</field>
        <field name="arch" type="xml">
            <form string="Technical Document">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="doc_type"/>
                            <field name="version" readonly="1"/>
                        </group>
                        <group>
                            <field name="uploaded_by" readonly="1"/>
                            <field name="upload_date" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="file_name"/>
                        <field name="file_data" filename="file_name"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Catatan revisi..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avs_technical_document_search" model="ir.ui.view">
        <field name="name">avs.technical.document.search</field>
        <field name="model">avs.technical.document</field>
        <field name="arch" type="xml">
            <search string="Technical Documents">
                <field name="name"/>
                <field name="project_id"/>
                <field name="doc_type"/>
                <filter string="DRO" name="doc_type_dro" domain="[('doc_type', '=', 'dro')]"/>
                <filter string="CAD" name="doc_type_cad" domain="[('doc_type', '=', 'cad')]"/>
                <filter string="UAT" name="doc_type_uat" domain="[('doc_type', '=', 'uat')]"/>
                <filter string="Other" name="doc_type_other" domain="[('doc_type', '=', 'other')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_by_doc_type" context="{'group_by': 'doc_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_avs_technical_document" model="ir.actions.act_window">
        <field name="name">Technical Repository</field>
        <field name="res_model">avs.technical.document</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_avs_technical_document_search"/>
        <field name="context">{'default_active': True}</field>
    </record>

    <menuitem
        id="menu_avs_technical_repository"
        name="Technical Repository"
        parent="avs_project.menu_avs_project_management_root"
        action="action_avs_technical_document"
        sequence="30"
        groups="avs_project.group_avs_pmo,avs_project.group_avs_engineer,avs_project.group_avs_sales"
    />

    <record id="view_project_form_inherit_technical_repository_button" model="ir.ui.view">
        <field name="name">project.project.form.inherit.technical.repository.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_technical_documents"
                    icon="fa-folder-open"
                    groups="avs_project.group_avs_pmo,avs_project.group_avs_engineer,avs_project.group_avs_sales"
                >
                    <field name="x_technical_document_count" string="Technical Documents" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
