<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_avs_management" model="ir.module.category">
            <field name="name">AVS Management</field>
            <field name="description">Kategori hak akses untuk sistem PT Alam Virtual Semesta</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_avs_sales" model="res.groups">
            <field name="name">Sales</field>
            <field name="category_id" ref="module_category_avs_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Akses untuk tim sales melihat pipeline dan progres proyek.</field>
        </record>

        <record id="group_avs_engineer" model="res.groups">
            <field name="name">Staff Engineering</field>
            <field name="category_id" ref="module_category_avs_management"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="comment">Akses untuk engineer memperbarui task dan unggah dokumen teknis.</field>
        </record>

        <record id="group_avs_pmo" model="res.groups">
            <field name="name">PMO (Project Management Office)</field>
            <field name="category_id" ref="module_category_avs_management"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_manager')), (4, ref('group_avs_engineer'))]"/>
            <field name="comment">Akses penuh untuk mengelola proyek, load balancing, dan repositori.</field>
        </record>

        <record id="avs_rule_engineer_own_tasks" model="ir.rule">
            <field name="name">Engineer: See assigned tasks only</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('group_avs_engineer'))]"/>
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        </record>

        <record id="avs_rule_sales_read_all_projects" model="ir.rule">
            <field name="name">Sales: Read-only all projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[(4, ref('group_avs_sales'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>